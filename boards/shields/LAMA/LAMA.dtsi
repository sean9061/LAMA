#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &lama_physical_layout;
    };

    lama_physical_layout: lama_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        /* 座標はpcb/v2のroba_L / roba_R.kicad_pcbのスイッチ位置から算出(1u = 19.05mm)。
           R側はL側と左右対称になるよう平行移動している。 */
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100     0   61       0     0     0>
            , <&key_physical_attrs 100 100   100   61       0     0     0>
            , <&key_physical_attrs 100 100   200   25       0     0     0>
            , <&key_physical_attrs 100 100   300    0       0     0     0>
            , <&key_physical_attrs 100 100   400   13       0     0     0>
            , <&key_physical_attrs 100 100   500   26       0     0     0>

            , <&key_physical_attrs 100 100   900   26       0     0     0>
            , <&key_physical_attrs 100 100  1000   13       0     0     0>
            , <&key_physical_attrs 100 100  1100    0       0     0     0>
            , <&key_physical_attrs 100 100  1200   25       0     0     0>
            , <&key_physical_attrs 100 100  1300   61       0     0     0>
            , <&key_physical_attrs 100 100  1400   61       0     0     0>

            , <&key_physical_attrs 100 100     0  161       0     0     0>
            , <&key_physical_attrs 100 100   100  161       0     0     0>
            , <&key_physical_attrs 100 100   200  125       0     0     0>
            , <&key_physical_attrs 100 100   300  100       0     0     0>
            , <&key_physical_attrs 100 100   400  113       0     0     0>
            , <&key_physical_attrs 100 100   500  126       0     0     0>
            , <&key_physical_attrs 100 100   600  150       0     0     0>

            , <&key_physical_attrs 100 100   800  150       0     0     0>
            , <&key_physical_attrs 100 100   900  126       0     0     0>
            , <&key_physical_attrs 100 100  1000  113       0     0     0>
            , <&key_physical_attrs 100 100  1100  100       0     0     0>
            , <&key_physical_attrs 100 100  1200  125       0     0     0>
            , <&key_physical_attrs 100 100  1300  161       0     0     0>
            , <&key_physical_attrs 100 100  1400  161       0     0     0>

            , <&key_physical_attrs 100 100     0  261       0     0     0>
            , <&key_physical_attrs 100 100   100  261       0     0     0>
            , <&key_physical_attrs 100 100   200  225       0     0     0>
            , <&key_physical_attrs 100 100   300  200       0     0     0>
            , <&key_physical_attrs 100 100   400  213       0     0     0>
            , <&key_physical_attrs 100 100   500  226       0     0     0>
            , <&key_physical_attrs 100 100   600  250       0     0     0>

            , <&key_physical_attrs 100 100   800  250       0     0     0>
            , <&key_physical_attrs 100 100   900  226       0     0     0>
            , <&key_physical_attrs 100 100  1000  213       0     0     0>
            , <&key_physical_attrs 100 100  1100  200       0     0     0>
            , <&key_physical_attrs 100 100  1200  225       0     0     0>
            , <&key_physical_attrs 100 100  1300  261       0     0     0>
            , <&key_physical_attrs 100 100  1400  261       0     0     0>

            , <&key_physical_attrs 100 100     0  361       0     0     0>
            , <&key_physical_attrs 100 100   100  361       0     0     0>
            , <&key_physical_attrs 100 100   200  325       0     0     0>
            , <&key_physical_attrs 100 100   300  300       0     0     0>
            , <&key_physical_attrs 100 100   421  352       0     0     0>
            , <&key_physical_attrs 100 100   533  361     900   583   411>
            , <&key_physical_attrs 100 100   644  390    2000   694   440>

            , <&key_physical_attrs 100 100   756  390 (-2000)   806   440>
            , <&key_physical_attrs 100 100   866  361 (-1000)   916   411>
            , <&key_physical_attrs 100 100  1300  361       0     0     0>
            , <&key_physical_attrs 100 100  1400  362       0     0     0>
            ;
    };

    /* 列番号はPCBのネット名Col0-Col6(L)/Col0-Col5(R, col-offset=7で7-12)に一致させている。
       L: Col0=増設した小指列, Col1-5=Q-T列, Col6=内側列(row1はエンコーダ押し込み)
       R: Col0-4=Y-P列, Col5=増設した小指列。R側のrow3は内側キー(Col0,1)と親指(Col2,3)を兼ねる */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <13>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                                     RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)                     RC(3,7) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)                     RC(3,8) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)                     RC(3,9) RC(3,10)                          RC(3,11) RC(3,12)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
            row-gpios
                = <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <12>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <10>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
};

&spi0 {
    status = "disabled";

    trackball: trackball@0 {
        status = "disabled";
        reg = <0>;
    };
};
